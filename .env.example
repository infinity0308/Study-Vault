# ==============================================================================
# StudyVault Production Configuration
# ==============================================================================

# Django Core Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ------------------------------------------------------------------------------
# PostgreSQL Database (used by Docker Compose)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://studyvault:studyvault_secure_password@db:5432/studyvault

# ------------------------------------------------------------------------------
# Celery Task Broker (Redis used by Docker Compose)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Qdrant Vector Database (used by Docker Compose)
# ------------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=study_chunks_v1

# ------------------------------------------------------------------------------
# Cloudflare R2 Storage (External private bucket)
# 1. In Cloudflare Dashboard -> R2 -> Create Bucket 'studyvault-docs'
# 2. Manage R2 API Tokens -> Create API Token (Object Read & Write permission)
# 3. Copy Account ID, Access Key ID, and Secret Access Key below:
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=studyvault-docs
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# Google Gemma & Embedding AI Model APIs
# 1. Obtain an API key from Google AI Studio / Google Cloud Vertex AI
# 2. Enter GEMMA_API_KEY below (used for both Gemma and GenAI text-embedding)
# ------------------------------------------------------------------------------
LLM_PROVIDER=google_gemma
GEMMA_API_KEY=your_google_ai_studio_or_gemma_api_key
GEMMA_MODEL=gemma-2-9b-it

EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
